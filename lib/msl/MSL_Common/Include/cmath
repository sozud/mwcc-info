/*modff is the same everywhere */

inline float modff( float x, float *iptr)
 {
  switch( fpclassify(x))
   {
    case FP_NAN: 
    case FP_ZERO:
     *iptr=x;  
     return x;
     break;
    case FP_INFINITE:
     *iptr=x;
     return 0.0f;
     break;
    case FP_SUBNORMAL:
     *iptr=0.0f;
     return x;
     break;
    default:                      /*normal case */
     const _INT32 i = (_INT32)x;  /*truncated toward zero */
     const float frac=x-(float)i; /* fractional part of x(subtraction is exact in this case) */                            
     if((!(*(_INT32*)&frac)) || ((*(_INT32*)&x)&0x7f800000) >= 0x4B800000) 
     { 
      *iptr=x;
      return 0.0f ;
     }
      *iptr=i;
      return frac ;	
   }
} 


